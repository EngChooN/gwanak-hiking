{
  "name": "gwanak-hiking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/copy-assets.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "build:pages": "BASE_PATH=/gwanak-hiking/ npm run build",
    "preview:pages": "BASE_PATH=/gwanak-hiking/ vite preview --host 127.0.0.1 --port 4173",
    "deploy": "node scripts/deploy-pages.mjs",
    "simulate": "node scripts/simulate.mjs",
    "test": "node --test tests/*.test.mjs",
    "capture": "node scripts/capture.mjs",
    "report": "node scripts/report.mjs",
    "assets:build": "node assets/source/build-assets.mjs && node assets/source/build-chunks.mjs && node assets/source/build-toon-assets.mjs && node assets/source/build-toon-hiker-rig.mjs",
    "assets:verify": "node assets/source/verify-capture.mjs",
    "assets:report": "node assets/source/make-report.mjs",
    "test:e2e": "playwright test",
    "server": "node server/multi-server.mjs",
    "multi:server": "node server/multi-server.mjs",
    "multi:up": "node scripts/multi-up.mjs",
    "multi:publish": "node scripts/multi-publish.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "vite": "^7.1.0",
    "@playwright/test": "^1.56.0"
  }
}
