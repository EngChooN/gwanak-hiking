 "prelude": "window.P=(()=>{const L=window.lounge,log=[],t0=performance.now();addEventListener('lounge:smoke',e=>{if(e.detail?.id==='me')log.push({t:Math.round(performance.now()-t0),state:e.detail.state});});const q=s=>document.querySelector(s);return {L,log,q,tap(s){const e=q(s);if(e)e.click();return !!e;},draw(on){L.hud.press('draw',on);},at(x,z,h,cam){L.teleport(x,z,h);if(cam)L.setCam(cam);},npc(id){return L.npcs.avatars.find(a=>a.id===id);},put(id,x,z,h){P.npc(id)?.place(x,z,h);},light(kind){L.smoker.start(kind||'mild');setTimeout(()=>L.smoker.light(),1000);},chat(text){const f=q('.lg-form'),i=f?.querySelector('input');if(!i)return false;i.value=text;f.requestSubmit();return true;},type(s,text){const i=q(s);if(!i)return false;i.value=text;i.dispatchEvent(new Event('input',{bubbles:true}));return true;},hold(cam,ms){const end=performance.now()+ms,f=()=>{L.setCam(cam);if(performance.now()<end)requestAnimationFrame(f);};f();},hideMarks(){const s=document.createElement('style');s.textContent='.sp-marks{visibility:hidden}';document.head.appendChild(s);},mark(k){document.querySelectorAll('.smoke [data-a=kind]').forEach(b=>b.classList.toggle('on',b.dataset.k===k));}};})();",
