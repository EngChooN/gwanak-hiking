{
 "version": 1,
 "format": {
  "순서": "shots 배열 순서대로 찍는다. 같은 scene 번호(5a·5b·5c)는 편집에서 이어 붙여 한 장면으로 쓴다.",
  "viewport": "playwright newContext 값 그대로(405×720, 배율 2.6667 → 1080×1920).",
  "profile": "addInitScript로 localStorage[storageKey]에 넣는다 = 공통 profile + 장면 profile(덮어쓰기). 페이지마다 처음 한 번만.",
  "query": "BASE_URL+path+'?'+query. {WS}는 로컬 멀티 서버 주소(ws://127.0.0.1:multi.port, encodeURIComponent)로 바꾼다.",
  "multi": "있으면 두 번째 브라우저 컨텍스트(따로 된 창)에 friend 페이지를 friendQuery로 연다(같은 컨텍스트의 두 번째 탭은 그리기가 멈춰 걷기가 안 됨). 같은 방은 로컬 멀티 서버로 잇는다: server/multi-server.mjs startServer를 multi.port에. 찍는 화면은 main.",
  "준비": "window.lounge가 생기면 페이지마다 prelude를 evaluate → settleMs 기다림 → prep[페이지] evaluate → prepWaitMs 기다림 → 이때가 시점 0.",
  "actions": "시점 0부터 노드 쪽 시계로 at(ms)에 js를 evaluate. who 없으면 main.",
  "clip": "[[시작ms,길이ms],…] 시점 0 기준으로 잘라 쓸 구간. 여러 개면 순서대로 이어 붙인다(점프 컷). 길이 합 = sec.",
  "checkAt": "점검용 캡처 시점(check-shots.mjs만 씀, 녹화에는 필요 없음).",
  "점검": "node scripts/promo/check-shots.mjs [키…] (BASE_URL 기본 http://127.0.0.1:5181)",
  "장면 3·7(11-13)": "장면 3: 묘기 단추를 먼저 열고 들이마시는 중에 링을 눌러 첫 내뿜기를 링으로 시작, 카메라는 옆 45°(yaw 1.5π+.8)라 링이 얼굴 옆으로 동그랗게 보임. 장면 7: 말풍선(약 6초)이 겹치지 않게 하늘 0.3초·동동 6.3초로 어긋나게 말하고, 두 구간을 이어 붙임(하늘 말풍선이 사라진 뒤 동동 말풍선)."
 },
